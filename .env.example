# Team Codix - Environment Configuration
# Copy this file to .env.local and update with your actual values

# Base site URL for metadataBase, Open Graph, and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://teamcodix.com

# Web3Forms API Key for instant contact form email delivery directly to codix.team26@gmail.com
# Obtain a key for free from: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=f55a71cd-d4a8-4e37-9eea-3d065c97df2d

# Optional: Resend API Key for sending contact form emails
# Obtain your key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email address for contact inquiries
CONTACT_TO_EMAIL=codix.team26@gmail.com

# Optional sender address (default uses Resend onboarding domain or your verified domain)
# Example: CONTACT_FROM_EMAIL="Team Codix <inquiries@teamcodix.com>"
CONTACT_FROM_EMAIL=Team Codix <onboarding@resend.dev>
